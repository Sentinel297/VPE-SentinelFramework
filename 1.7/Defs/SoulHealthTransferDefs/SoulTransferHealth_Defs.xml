<Defs>
	<SentinelFramework_STNL.SoulHealthTransferDef>
		<defName>VPE_SentinelFramework_SoulHediffTransfer_Mental_STNL</defName>
		<removePassives>true</removePassives>
		<allowedTransferHediffs>
			<!-- Neurophage -->
			<li MayRequire="VPE.Neurophage.Sentinel">VPE_Neurophage_Neurophagy_STNL</li>
			<!-- Blackwall -->
			<li MayRequire="VPE.Blackwall.Sentinel">VPE_Blackwall_Psychosis_Hediff_STNL</li>
			<!-- Anomaly -->
			<li MayRequire="Ludeon.Rimworld.Anomaly">Inhumanized</li>
			<li MayRequire="Ludeon.Rimworld.Anomaly">VoidTouched</li>
			<li MayRequire="Ludeon.Rimworld.Anomaly">Psychophage</li>
		</allowedTransferHediffs>
		<hediffsToRemove>
			<!-- Neurophage -->
			<li MayRequire="VPE.Neurophage.Sentinel">VPE_Neurophage_NeuralString_Controller_STNL</li>
			<!-- Blackwall -->
			<li MayRequire="VPE.Blackwall.Sentinel">VPE_Blackwall_Conduit_Hediff_STNL</li>
			<!-- Scarlet -->
			<li MayRequire="VPE.Scarlet.Sentinel">VPE_MechaniteFocusHediffSTNL</li>
			<li MayRequire="VPE.Scarlet.Sentinel">VPE_ScarvestHediffSTNL</li>
		</hediffsToRemove>
	</SentinelFramework_STNL.SoulHealthTransferDef>
	
	<!-- Used in SwapSouls, transfers everything from one pawn to another, including bionics, mechlinks, diseases, etc -->
	
	<SentinelFramework_STNL.SoulHealthTransferDef>
		<defName>VPE_SentinelFramework_SoulHediffTransfer_Full_STNL</defName>
		<allowEverything>true</allowEverything>
		<hediffsToRemove>
			<!-- Neurophage -->
			<li MayRequire="VPE.Neurophage.Sentinel">VPE_Neurophage_NeuralString_Controller_STNL</li>
			<!-- Blackwall -->
			<li MayRequire="VPE.Blackwall.Sentinel">VPE_Blackwall_Conduit_Hediff_STNL</li>
			<!-- Veincaster -->
			<li MayRequire="VPE.Veincaster.Sentinel">VPE_Bloodlink_Receiver_STNL</li>
			<li MayRequire="VPE.Veincaster.Sentinel">VPE_Bloodlink_Donor_STNL</li>
		</hediffsToRemove>
	</SentinelFramework_STNL.SoulHealthTransferDef>
</Defs>